[Unit]
Description=Sprinkler API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/sprinklers/api
ExecStart=/home/pi/sprinklers/sprinklers_venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
